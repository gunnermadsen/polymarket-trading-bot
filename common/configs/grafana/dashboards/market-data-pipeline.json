  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["market-data", "pipeline", "grpc", "trading-critical"],
  "templating": {
    "list": [
      {
        "name": "process_id",
        "label": "Process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(polymarket_execution_freshness_expected, process_id)",
        "query": {
          "query": "label_values(polymarket_execution_freshness_expected, process_id)",
          "refId": "execution-processes"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
