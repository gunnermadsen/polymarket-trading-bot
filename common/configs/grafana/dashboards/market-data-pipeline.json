{
  "annotations": {"list": []},
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {"title": "Ingester health", "type": "link", "url": "/d/market-data-ingester-health", "targetBlank": false},
    {"title": "Directional runtime", "type": "link", "url": "/d/directional-runtime-health", "targetBlank": false}
  ],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Worker Route Coverage", "description": "Active direct worker routes compared with the routes required by the deduplicated selector union.", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max(polymarket_market_data_grpc_connections)", "instant": true, "legendFormat": "Active"},
        {"refId": "B", "expr": "max(polymarket_market_data_grpc_desired_connections)", "instant": true, "legendFormat": "Required"},
        {"refId": "C", "expr": "clamp_min(max(polymarket_market_data_grpc_desired_connections) - max(polymarket_market_data_grpc_connections), 0)", "instant": true, "legendFormat": "Missing"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 8, "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "center", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2, "type": "stat", "title": "Core Realtime Delivery Latency", "description": "Time from worker publication to application in the shared bot runtime. Source cadence is intentionally excluded.", "gridPos": {"x": 6, "y": 0, "w": 9, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_btc_five_minute_orderbooks\"} * 1000", "instant": true, "legendFormat": "Polymarket order book"},
        {"refId": "B", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_rtds_chainlink_reference_price\"} * 1000", "instant": true, "legendFormat": "Chainlink reference price"},
        {"refId": "C", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_chainlink_btcusd_twap\"} * 1000", "instant": true, "legendFormat": "Chainlink 60-second TWAP"},
        {"refId": "D", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"binance_spot_btcusdt_one_second_ohlcv\"} * 1000", "instant": true, "legendFormat": "Binance BTC/USDT 1-second candle"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 50}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3, "type": "stat", "title": "Integrity · Last Hour", "gridPos": {"x": 15, "y": 0, "w": 9, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum(increase(polymarket_market_data_sequence_gaps_total[1h]))", "instant": true, "legendFormat": "Sequence gaps"},
        {"refId": "B", "expr": "sum(increase(ingester_stream_dropped_total[1h]))", "instant": true, "legendFormat": "Dropped events"},
        {"refId": "C", "expr": "sum(increase(polymarket_market_data_decode_errors_total[1h]))", "instant": true, "legendFormat": "Contract errors"}
      ],
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4, "type": "timeseries", "title": "Pipeline Throughput", "gridPos": {"x": 0, "y": 5, "w": 14, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (product) (rate(ingester_stream_published_total[2m]))", "legendFormat": "published · {{product}}"},
        {"refId": "B", "expr": "sum by (product) (rate(polymarket_market_data_product_events_applied_total[2m]))", "legendFormat": "applied · {{product}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Core Realtime Latency Trend", "description": "Worker publication to shared-runtime application latency for continuous model inputs.", "gridPos": {"x": 14, "y": 5, "w": 10, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_btc_five_minute_orderbooks\"} * 1000", "legendFormat": "Polymarket order book"},
        {"refId": "B", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_rtds_chainlink_reference_price\"} * 1000", "legendFormat": "Chainlink reference price"},
        {"refId": "C", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"polymarket_chainlink_btcusd_twap\"} * 1000", "legendFormat": "Chainlink 60-second TWAP"},
        {"refId": "D", "expr": "polymarket_market_data_product_publish_apply_latency_seconds{product=\"binance_spot_btcusdt_one_second_ohlcv\"} * 1000", "legendFormat": "Binance BTC/USDT 1-second candle"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 50}]}, "custom": {"lineWidth": 2, "fillOpacity": 16, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 6, "type": "state-timeline", "title": "Product Demand and Delivery", "description": "One state per required product: selector demand at the owning worker plus bot-side delivery readiness.", "gridPos": {"x": 0, "y": 14, "w": 14, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "max by (product) (ingester_stream_subscribers) + on(product) max by (product) (polymarket_market_data_product_ready)", "legendFormat": "{{product}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Not requested", "color": "gray"}, "1": {"text": "Waiting for delivery", "color": "red"}, "2": {"text": "Receiving", "color": "green"}}}], "custom": {"fillOpacity": 80, "lineWidth": 0}}, "overrides": []},
      "options": {"alignValue": "left", "legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "mergeValues": true, "rowHeight": 0.8, "showValue": "never", "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Route Stability", "description": "Independent worker-route reconnects and their bounded failure classifications.", "gridPos": {"x": 14, "y": 14, "w": 10, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "increase(polymarket_market_data_grpc_reconnects_total[5m])", "legendFormat": "Worker reconnects · 5m"},
        {"refId": "B", "expr": "sum by (reason) (increase(polymarket_market_data_route_failures_total[5m]))", "legendFormat": "{{reason}} · 5m"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "id": 8, "type": "state-timeline", "title": "Required Product Readiness", "description": "Readiness reported by each product's owning worker route. A route failure affects only its products.", "gridPos": {"x": 0, "y": 22, "w": 14, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "polymarket_market_data_product_ready", "legendFormat": "{{product}}"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "Unavailable", "color": "red"}, "1": {"text": "Ready", "color": "green"}}}], "custom": {"fillOpacity": 80, "lineWidth": 0}}, "overrides": []},
      "options": {"alignValue": "left", "legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "mergeValues": true, "rowHeight": 0.8, "showValue": "never", "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 9, "type": "stat", "title": "Binance 1-Second Source Service", "description": "Keepalive response, persistence handoff, and provider reconnection health for the canonical one-second candle source.", "gridPos": {"x": 14, "y": 22, "w": 10, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max(ingester_source_websocket_pong_latency_seconds{product=\"binance_spot_btcusdt_one_second_ohlcv\"}) * 1000", "instant": true, "legendFormat": "PING to PONG"},
        {"refId": "B", "expr": "max(ingester_source_persistence_latency_seconds{product=\"binance_spot_btcusdt_one_second_ohlcv\"}) * 1000", "instant": true, "legendFormat": "Persistence batch"},
        {"refId": "C", "expr": "max(ingester_source_persistence_queue_depth{product=\"binance_spot_btcusdt_one_second_ohlcv\"})", "instant": true, "legendFormat": "Queued events"},
        {"refId": "D", "expr": "sum(increase(ingester_source_reconnects_total{product=\"binance_spot_btcusdt_one_second_ohlcv\"}[15m]))", "instant": true, "legendFormat": "Source reconnects · 15m"}
      ],
      "fieldConfig": {"defaults": {"decimals": 1, "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 50}]}}, "overrides": [
        {"matcher": {"id": "byName", "options": "PING to PONG"}, "properties": [{"id": "unit", "value": "ms"}]},
        {"matcher": {"id": "byName", "options": "Persistence batch"}, "properties": [{"id": "unit", "value": "ms"}]},
        {"matcher": {"id": "byName", "options": "Queued events"}, "properties": [{"id": "decimals", "value": 0}]},
        {"matcher": {"id": "byName", "options": "Source reconnects · 15m"}, "properties": [{"id": "decimals", "value": 0}]}
      ]},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 10, "type": "row", "title": "Polymarket RTDS Source Health", "collapsed": false, "panels": [], "gridPos": {"x": 0, "y": 30, "w": 24, "h": 1}
    },
    {
      "id": 11, "type": "stat", "title": "RTDS Reference Source", "description": "Provider connection state, age of the latest valid Chainlink source event, and age of the latest canonical publication.", "gridPos": {"x": 0, "y": 31, "w": 10, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "max(ingester_source_connection_ready{product=\"polymarket_rtds_chainlink_reference_price\"})", "instant": true, "legendFormat": "Connected"},
        {"refId": "B", "expr": "time() - max(ingester_source_last_event_timestamp_seconds{product=\"polymarket_rtds_chainlink_reference_price\"})", "instant": true, "legendFormat": "Source event age"},
        {"refId": "C", "expr": "time() - max(ingester_stream_last_published_timestamp_seconds{product=\"polymarket_rtds_chainlink_reference_price\"})", "instant": true, "legendFormat": "Publish age"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 30}]}}, "overrides": [
        {"matcher": {"id": "byName", "options": "Connected"}, "properties": [{"id": "unit", "value": "none"}]},
        {"matcher": {"id": "byName", "options": "Source event age"}, "properties": [{"id": "unit", "value": "s"}]},
        {"matcher": {"id": "byName", "options": "Publish age"}, "properties": [{"id": "unit", "value": "s"}]}
      ]},
      "options": {"colorMode": "value", "graphMode": "none", "orientation": "horizontal", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 12, "type": "timeseries", "title": "RTDS Recovery Activity", "description": "Provider reconnects and transitions into source staleness, classified by bounded reason.", "gridPos": {"x": 10, "y": 31, "w": 14, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "expr": "sum by (reason) (increase(ingester_source_reconnects_total{product=\"polymarket_rtds_chainlink_reference_price\"}[10m]))", "legendFormat": "Reconnect · {{reason}}"},
        {"refId": "B", "expr": "sum by (reason) (increase(ingester_source_stale_transitions_total{product=\"polymarket_rtds_chainlink_reference_price\"}[10m]))", "legendFormat": "Stale · {{reason}}"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 12, "showPoints": "never"}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 41,
  "tags": ["market-data", "pipeline", "grpc", "trading-critical"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Market Data Pipeline",
  "uid": "market-data-pipeline",
  "version": 4
}
