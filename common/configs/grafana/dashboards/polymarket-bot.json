          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH exit_events AS (\n  SELECT\n    COALESCE(e.process_id, tp.process_id) AS process_id,\n    e.timestamp_utc,\n    e.net_pnl\n  FROM polymarket.trade_exits e\n  JOIN polymarket.trade_positions tp\n    ON tp.position_id = e.position_id\n  JOIN polymarket.trading_processes proc\n    ON proc.process_id = COALESCE(e.process_id, tp.process_id)\n  WHERE NOT e.is_synthetic\n    AND COALESCE(e.process_id, tp.process_id) IS NOT NULL\n    AND proc.process_scope = 'backtest'\n), baseline AS (\n  SELECT\n    process_id,\n    COALESCE(SUM(net_pnl), 0) AS realized_before\n  FROM exit_events\n  WHERE timestamp_utc < $__timeFrom()\n  GROUP BY process_id\n), bucketed AS (\n  SELECT\n    $__timeGroupAlias(timestamp_utc, $__interval),\n    process_id,\n    SUM(net_pnl) AS bucket_realized_pnl\n  FROM exit_events\n  WHERE $__timeFilter(timestamp_utc)\n  GROUP BY 1, process_id\n)\nSELECT\n  b.\"time\",\n  left(b.process_id::text, 8) AS metric,\n  (\n    COALESCE(bl.realized_before, 0)\n    + SUM(b.bucket_realized_pnl) OVER (\n      PARTITION BY b.process_id\n      ORDER BY b.\"time\"\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    )\n  )::double precision AS value\nFROM bucketed b\nLEFT JOIN baseline bl\n  ON bl.process_id = b.process_id\nORDER BY b.\"time\", metric;",
          "refId": "A",
          "sql": {
