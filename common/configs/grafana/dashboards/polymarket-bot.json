        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH mark_points AS (\n  SELECT\n    $__timeGroup(m.timestamp_utc, $__interval) AS \"time\",\n    COALESCE(m.process_id, p.process_id) AS process_id,\n    m.position_id,\n    m.timestamp_utc,\n    m.net_unrealized_pnl\n  FROM polymarket.trade_marks m\n  JOIN polymarket.trade_positions p\n    ON p.position_id = m.position_id\n  WHERE $__timeFilter(m.timestamp_utc)\n    AND p.status IN ('open', 'partially_closed')\n    AND COALESCE(m.process_id, p.process_id) IS NOT NULL\n), latest_marks AS (\n  SELECT\n    \"time\",\n    process_id,\n    position_id,\n    net_unrealized_pnl,\n    ROW_NUMBER() OVER (\n      PARTITION BY \"time\", process_id, position_id\n      ORDER BY timestamp_utc DESC\n    ) AS mark_rank\n  FROM mark_points\n)\nSELECT\n  \"time\",\n  left(process_id::text, 8) AS metric,\n  SUM(net_unrealized_pnl)::double precision AS value\nFROM latest_marks\nWHERE mark_rank = 1\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
