    {
      "id": 13,
      "title": "Execution freshness violations (since process start)",
      "description": "Paper fills and local live POST attempts with stale, noncausal or missing canonical book evidence. Counters reset with the process; see alert history for prior incidents.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "polymarket_execution_freshness_violations_total{process_id=~\"${process_id:regex}\"}",
          "legendFormat": "{{process_id}} {{execution_mode}} {{evidence}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 14,
      "title": "Freshness rejections (5m)",
      "description": "Prevented executions, not unsafe fills. No requests means zero rejections.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(polymarket_execution_freshness_book_rejections_total{process_id=~\"${process_id:regex}\"}[5m]) + increase(polymarket_execution_freshness_reference_rejections_total{process_id=~\"${process_id:regex}\"}[5m])",
          "legendFormat": "{{process_id}} {{execution_mode}} {{evidence}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 15,
      "title": "Execution freshness monitoring coverage",
      "description": "One is instrumented; zero is an active process with missing instrumentation. Missing data is not healthy. Idle instrumented processes remain one.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(polymarket_execution_freshness_expected{process_id=~\"${process_id:regex}\"} * on(process_id, execution_mode, job, instance) polymarket_execution_freshness_monitor_ready{process_id=~\"${process_id:regex}\"}) or (0 * polymarket_execution_freshness_expected{process_id=~\"${process_id:regex}\"})",
          "legendFormat": "{{process_id}} {{execution_mode}} {{evidence}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 16,
      "title": "Book ages at last execution",
      "description": "Canonical checkpoint source and receipt ages measured at the paper fill snapshot or local live POST. These are not current feed ages or exchange-arrival measurements.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "polymarket_execution_freshness_last_execution_book_age_milliseconds{process_id=~\"${process_id:regex}\"}",
          "legendFormat": "{{process_id}} {{execution_mode}} {{evidence}}",
          "range": true,
          "editorMode": "code"
        }
      ]
    }
  ],
  "refresh": "20s",
  "schemaVersion": 41,
  "tags": ["polymarket", "runtime", "market-data"],
  "templating": {
    "list": [
      {
        "name": "process_id",
        "label": "Process",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(polymarket_execution_freshness_expected, process_id)",
        "query": {
          "query": "label_values(polymarket_execution_freshness_expected, process_id)",
          "refId": "execution-processes"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
