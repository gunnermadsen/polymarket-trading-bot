# syntax=docker/dockerfile:1.7

ARG RUST_VERSION=1.92.0
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY packages/polymarket-bot/Cargo.toml packages/polymarket-bot/Cargo.toml
COPY packages/market-data-ingester/Cargo.toml packages/market-data-ingester/Cargo.toml
COPY packages/polymarket-bot/build.rs packages/polymarket-bot/build.rs
COPY common/proto common/proto

RUN mkdir -p packages/polymarket-bot/src/bin \
    && printf 'pub fn placeholder() {}\n' > packages/polymarket-bot/src/lib.rs \
    && printf 'fn main() {}\n' > packages/polymarket-bot/src/main.rs \
    && printf 'fn main() {}\n' > packages/polymarket-bot/src/bin/derive-clob-creds.rs

# Keep compiled dependencies in a normal layer so remote BuildKit cache exporters
# can reuse them on ephemeral GitHub Actions runners.
RUN cargo build --locked --release --package polymarket-bot

COPY packages/polymarket-bot/src packages/polymarket-bot/src
COPY packages/btc-directional-model/runtime-models /opt/polymarket-models

RUN chmod -R u=rwX,go=rX /opt/polymarket-models \
    && cargo clean --release -p polymarket-bot \
    && cargo build --locked --release --package polymarket-bot \
    && cp /app/target/release/polymarket-bot /usr/local/bin/polymarket-bot \
    && cp /app/target/release/derive-clob-creds /usr/local/bin/derive-clob-creds

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10002 --create-home --shell /usr/sbin/nologin polymarket

ARG POLYMARKET_GIT_REVISION
RUN case "$POLYMARKET_GIT_REVISION" in \
      ""|*[!0-9a-f]*) \
        echo "POLYMARKET_GIT_REVISION must be a lowercase hexadecimal Git commit ID" >&2; \
        exit 64 \
        ;; \
    esac \
    && case "${#POLYMARKET_GIT_REVISION}" in \
      40|64) ;; \
      *) \
        echo "POLYMARKET_GIT_REVISION must contain 40 or 64 characters" >&2; \
        exit 64 \
        ;; \
    esac

LABEL org.opencontainers.image.source="https://github.com/gunnermadsen/polymarket-trading-bot" \
      org.opencontainers.image.revision="$POLYMARKET_GIT_REVISION"

COPY --from=builder /usr/local/bin/polymarket-bot /usr/local/bin/polymarket-bot
COPY --from=builder /usr/local/bin/derive-clob-creds /usr/local/bin/derive-clob-creds
COPY --from=builder /opt/polymarket-models /usr/local/share/polymarket-bot/models

USER polymarket
ENV RUST_LOG=info
ENTRYPOINT ["/usr/local/bin/polymarket-bot"]
