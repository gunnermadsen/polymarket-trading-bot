# Materialize this template only after the fold-robust frequency training run completes.
# Replace __FOLD_ROBUST_RUN_ID__ with that run's UTC identifier before invoking
# frequency-policy-benchmark-run. The loader rejects unresolved or changed evidence.

[benchmark]
qualification_objective = "frequency"
policy_selection_mode = "single_frozen"
policy_anchor_fold = 0
probability_manifest = "runs/btc-fold-robust-frequency-20260421-20260720/__FOLD_ROBUST_RUN_ID__/saved-policy-probabilities/manifest.json"
control_candidate = "histogram_enriched"
candidate_names = [
  "histogram_enriched",
  "histogram_outcome_fold_robust_agreement",
]
evaluation_is_independent = false
evaluation_note = "One four-band confidence policy is selected from the earliest saved policy-selection cohort and applied unchanged to all five later chronological validation folds. This is consumed development evidence. The challenger preserves the control direction at every scored timestamp and boosts confidence only on auxiliary-model agreement. Frequency qualification preserves prediction-quality, exact-checkpoint, fold-stability, coverage, and five-share economics gates; entry timing is diagnostic-only."
quantity = 5.0

[policy]
threshold_candidates = [0.84, 0.85, 0.86, 0.87, 0.88, 0.89, 0.90, 0.91]
bands = [
  { name = "60-89", start_second = 60, end_second_exclusive = 90 },
  { name = "90-119", start_second = 90, end_second_exclusive = 120 },
  { name = "120-179", start_second = 120, end_second_exclusive = 180 },
  { name = "180-240", start_second = 180, end_second_exclusive = 241 },
]

[advancement_gates]
minimum_accuracy = 0.874
minimum_balanced_accuracy = 0.874
minimum_direction_recall = 0.874
minimum_wilson_lower_95 = 0.865
maximum_expected_calibration_error = 0.05
minimum_coverage = 0.55
minimum_selected_markets = 500
minimum_coverage_uplift = 0.000000001
maximum_accuracy_regression = 0.0
maximum_balanced_accuracy_regression = 0.0
maximum_direction_recall_regression = 0.0
minimum_common_checkpoint_markets = 500
minimum_executable_markets = 500
minimum_mean_direct_edge_per_share = 0.0
minimum_realized_net_per_share = 0.0
require_every_fold = true

[paths]
execution_evidence = "data/btc-execution-evidence-20260527-20260611"
runs = "runs/btc-fold-robust-frequency-policy-20260421-20260720"
