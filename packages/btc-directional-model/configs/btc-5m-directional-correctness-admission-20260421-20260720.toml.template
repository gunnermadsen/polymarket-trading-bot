[benchmark]
profile = "correctness_admission"
probability_manifest = "runs/btc-boundary-alignment-20260421-20260720/__BOUNDARY_RUN_ID__/saved-policy-probabilities/manifest.json"
core_config = "configs/btc-5m-directional-core-boundary-aligned-20260421-20260720.toml"
