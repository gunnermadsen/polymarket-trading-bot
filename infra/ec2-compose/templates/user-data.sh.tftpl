#!/bin/bash
set -euxo pipefail

exec > >(tee -a /var/log/polymarket-bootstrap.log | logger -t polymarket-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive

AWS_REGION="${aws_region}"
APP_DIRECTORY="${app_directory}"
APP_SECRET_NAME="${app_secret_name}"
COMPOSE_FILE="${compose_file}"
CLOUDFLARED_RDP_HOSTNAME="${cloudflare_rdp_hostname}"
CLOUDFLARED_SSH_HOSTNAME="${cloudflare_ssh_hostname}"
ECR_REGISTRY="${ecr_registry}"
ENABLE_CLOUDFLARED="${enable_cloudflared}"
ENABLE_DESKTOP="${enable_desktop}"
RDP_USERNAME="${rdp_username}"
REPO_BRANCH="${repo_branch}"
REPO_URL="${repo_url}"

apt_get_install() {
  apt-get install -y --no-install-recommends "$@"
}

configure_swap() {
  if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
    if [ ! -f /swapfile ]; then
      fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
      chmod 0600 /swapfile
      mkswap /swapfile
    fi

    swapon /swapfile
  fi

  grep -qE '^[[:space:]]*/swapfile[[:space:]]+none[[:space:]]+swap[[:space:]]' /etc/fstab \
    || printf '/swapfile none swap sw 0 0\n' >> /etc/fstab

  cat >/etc/sysctl.d/99-polymarket-swap.conf <<EOF
vm.swappiness=10
vm.vfs_cache_pressure=50
EOF

  sysctl --system >/dev/null
}

configure_apt_for_https_egress() {
  printf 'Acquire::ForceIPv4 "true";\n' >/etc/apt/apt.conf.d/99-force-ipv4

  if [ -f /etc/apt/sources.list ]; then
    sed -i 's#http://#https://#g' /etc/apt/sources.list
  fi

  if [ -d /etc/apt/sources.list.d ]; then
    find /etc/apt/sources.list.d -type f \( -name '*.list' -o -name '*.sources' \) \
      | while read -r source_file; do
          sed -i 's#http://#https://#g' "$source_file"
        done
  fi
}

json_value() {
  local key="$1"
  jq -r --arg key "$key" '.[$key] // empty' "$SECRET_PATH"
}

install_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return
  fi

  local arch aws_arch
  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64)
      aws_arch="x86_64"
      ;;
    aarch64|arm64)
      aws_arch="aarch64"
      ;;
    *)
      echo "Unsupported architecture for AWS CLI install: $arch" >&2
      exit 1
      ;;
  esac

  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$aws_arch.zip" -o /tmp/awscliv2.zip
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
}

install_base_packages() {
  configure_apt_for_https_egress
  apt-get update
  apt_get_install ca-certificates curl gnupg git jq nodejs unzip snapd

  if ! systemctl is-active --quiet snap.amazon-ssm-agent.amazon-ssm-agent.service; then
    snap install amazon-ssm-agent --classic || true
  fi

  systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true
  systemctl enable --now amazon-ssm-agent.service || true
  install_aws_cli
}

install_docker() {
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  chmod a+r /etc/apt/keyrings/docker.asc

  . /etc/os-release
  cat >/etc/apt/sources.list.d/docker.list <<EOF
deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable
EOF

  apt-get update
  apt_get_install docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
}

configure_ecr_login_refresh() {
  install -d -m 0700 /root/.docker

  cat >/usr/local/sbin/polymarket-ecr-login <<EOF
#!/bin/bash
set -euo pipefail

aws ecr get-login-password --region "$AWS_REGION" \\
  | docker login --username AWS --password-stdin "$ECR_REGISTRY"
EOF
  chmod 0700 /usr/local/sbin/polymarket-ecr-login

  cat >/etc/systemd/system/polymarket-ecr-login.service <<EOF
[Unit]
Description=Refresh Docker login for Polymarket ECR images
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/polymarket-ecr-login
EOF

  cat >/etc/systemd/system/polymarket-ecr-login.timer <<EOF
[Unit]
Description=Refresh Docker login for Polymarket ECR images every 6 hours

[Timer]
OnBootSec=1min
OnUnitActiveSec=6h
Persistent=true

[Install]
WantedBy=timers.target
EOF

  systemctl daemon-reload
  systemctl enable --now polymarket-ecr-login.timer
  /usr/local/sbin/polymarket-ecr-login
}

install_desktop() {
  if [ "$ENABLE_DESKTOP" != "true" ]; then
    return
  fi

  local rdp_password
  rdp_password="$(json_value RDP_PASSWORD)"
  if [ -z "$rdp_password" ]; then
    echo "Missing RDP_PASSWORD in AWS Secrets Manager secret $APP_SECRET_NAME" >&2
    exit 1
  fi

  apt_get_install software-properties-common
  add-apt-repository -y universe || true
  apt-get update
  apt_get_install dbus-x11 xdg-utils xfce4 xfce4-goodies xrdp xorgxrdp xserver-xorg-core xserver-xorg-input-all xserver-xorg-video-dummy xinit firefox

  if ! apt_get_install falkon; then
    echo "Falkon install failed; Firefox is already installed as the primary browser."
  fi

  if ! id "$RDP_USERNAME" >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash "$RDP_USERNAME"
  fi

  printf '%s:%s\n' "$RDP_USERNAME" "$rdp_password" | chpasswd
  usermod -aG ssl-cert "$RDP_USERNAME"
  printf 'startxfce4\n' >"/home/$RDP_USERNAME/.xsession"
  chown "$RDP_USERNAME:$RDP_USERNAME" "/home/$RDP_USERNAME/.xsession"
  chmod 0600 "/home/$RDP_USERNAME/.xsession"

  sed -i '/^\[Globals\]/,/^\[/{s/^port=.*/port=tcp:\/\/.:3389/}' /etc/xrdp/xrdp.ini
  usermod -aG ssl-cert xrdp
  systemctl enable xrdp xrdp-sesman
  systemctl restart xrdp-sesman xrdp
}

install_authorized_keys_for_user() {
  local username authorized_keys ssh_dir authorized_keys_file
  username="$1"
  authorized_keys="$2"

  if ! id "$username" >/dev/null 2>&1; then
    return
  fi

  ssh_dir="$(eval echo "~$username/.ssh")"
  authorized_keys_file="$ssh_dir/authorized_keys"

  install -d -m 0700 -o "$username" -g "$username" "$ssh_dir"
  touch "$authorized_keys_file"
  chown "$username:$username" "$authorized_keys_file"
  chmod 0600 "$authorized_keys_file"

  printf '%s\n' "$authorized_keys" \
    | sed '/^[[:space:]]*$/d' \
    >> "$authorized_keys_file"
  sort -u "$authorized_keys_file" -o "$authorized_keys_file"
  chown "$username:$username" "$authorized_keys_file"
  chmod 0600 "$authorized_keys_file"
}

install_ssh_authorized_keys() {
  local authorized_keys
  authorized_keys="$(json_value SSH_AUTHORIZED_KEYS)"
  if [ -z "$authorized_keys" ]; then
    return
  fi

  install_authorized_keys_for_user ubuntu "$authorized_keys"
  install_authorized_keys_for_user "$RDP_USERNAME" "$authorized_keys"
}

install_cloudflared() {
  if [ "$ENABLE_CLOUDFLARED" != "true" ]; then
    return
  fi

  local tunnel_id expected_tunnel_id credentials_b64 credentials_file rdp_hostname ssh_hostname deb_url
  expected_tunnel_id="$(json_value CLOUDFLARED_PRODUCTION_TUNNEL_ID)"
  credentials_b64="$(json_value CLOUDFLARED_PRODUCTION_TUNNEL_CREDENTIALS_B64)"
  rdp_hostname="$CLOUDFLARED_RDP_HOSTNAME"
  ssh_hostname="$CLOUDFLARED_SSH_HOSTNAME"

  if [ -z "$credentials_b64" ]; then
    echo "Missing CLOUDFLARED_PRODUCTION_TUNNEL_CREDENTIALS_B64 in AWS Secrets Manager secret $APP_SECRET_NAME" >&2
    exit 1
  fi

  case "$(uname -m)" in
    x86_64|amd64)
      deb_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb"
      ;;
    aarch64|arm64)
      deb_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-arm64.deb"
      ;;
    *)
      echo "Unsupported architecture for cloudflared install: $(uname -m)" >&2
      exit 1
      ;;
  esac

  curl -fsSL "$deb_url" -o /tmp/cloudflared.deb
  apt-get install -y /tmp/cloudflared.deb
  rm -f /tmp/cloudflared.deb

  install -d -m 0700 /etc/cloudflared
  printf '%s' "$credentials_b64" | base64 -d >/etc/cloudflared/credentials.json
  chmod 0600 /etc/cloudflared/credentials.json

  tunnel_id="$(jq -r '.TunnelID // .tunnelID // .tunnel_id // empty' /etc/cloudflared/credentials.json)"
  if [ -z "$tunnel_id" ]; then
    echo "Cloudflared credentials JSON is missing TunnelID" >&2
    exit 1
  fi

  if [ -n "$expected_tunnel_id" ] && [ "$expected_tunnel_id" != "$tunnel_id" ]; then
    echo "Cloudflared tunnel id mismatch between CLOUDFLARED_PRODUCTION_TUNNEL_ID and credentials JSON" >&2
    exit 1
  fi

  credentials_file="/etc/cloudflared/$tunnel_id.json"
  mv /etc/cloudflared/credentials.json "$credentials_file"
  chmod 0600 "$credentials_file"

  cat >/etc/cloudflared/config.yml <<EOF
tunnel: $tunnel_id
credentials-file: $credentials_file
ingress:
EOF

  if [ -n "$rdp_hostname" ]; then
    cat >>/etc/cloudflared/config.yml <<EOF
  - hostname: $rdp_hostname
    service: rdp://localhost:3389
EOF
  else
    cat >>/etc/cloudflared/config.yml <<EOF
  - service: rdp://localhost:3389
EOF
  fi

  if [ -n "$ssh_hostname" ]; then
    apt_get_install openssh-server
    systemctl enable --now ssh.service || systemctl enable --now sshd.service
    install_ssh_authorized_keys

    cat >>/etc/cloudflared/config.yml <<EOF
  - hostname: $ssh_hostname
    service: ssh://localhost:22
EOF
  fi

  if [ -n "$rdp_hostname" ]; then
    cat >>/etc/cloudflared/config.yml <<EOF
  - service: http_status:404
EOF
  fi

  chmod 0600 /etc/cloudflared/config.yml

  cat >/etc/systemd/system/cloudflared.service <<EOF
[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel --protocol http2 --config /etc/cloudflared/config.yml run
Restart=always
RestartSec=5s
User=root

[Install]
WantedBy=multi-user.target
EOF

  systemctl daemon-reload
  systemctl enable --now cloudflared.service
}

clone_or_update_repo() {
  local github_username github_pat auth_repo_url
  github_username="$(json_value GITHUB_USERNAME)"
  github_pat="$(json_value GITHUB_PAT)"

  if [ -z "$github_username" ] || [ -z "$github_pat" ]; then
    echo "Missing GITHUB_USERNAME or GITHUB_PAT in AWS Secrets Manager secret $APP_SECRET_NAME" >&2
    exit 1
  fi

  auth_repo_url="$(printf '%s' "$REPO_URL" | sed "s#https://#https://$github_username:$github_pat@#")"

  if [ -d "$APP_DIRECTORY/.git" ]; then
    git -C "$APP_DIRECTORY" fetch --prune origin "$REPO_BRANCH"
    git -C "$APP_DIRECTORY" checkout "$REPO_BRANCH"
    git -C "$APP_DIRECTORY" reset --hard "origin/$REPO_BRANCH"
  else
    rm -rf "$APP_DIRECTORY"
    git clone --branch "$REPO_BRANCH" "$auth_repo_url" "$APP_DIRECTORY"
  fi
}

write_app_env() {
  jq -r '
    to_entries
    | map(select(.key | startswith("GITHUB_") | not))
    | map(select(.key | startswith("GHCR_") | not))
    | map(select(.key | startswith("CLOUDFLARE_") | not))
    | map(select(.key | startswith("CLOUDFLARED_") | not))
    | map(select(.key | startswith("COLOUDFLARED_") | not))
    | map(select(.key | startswith("GF_") | not))
    | map(select(.key | startswith("GRAFANA_") | not))
    | map(select(.key != "POSTGRES_PASSWORD"))
    | map(select(.key != "RDP_PASSWORD"))
    | map(select(.key != "SSH_AUTHORIZED_KEYS"))
    | .[]
    | "\(.key)=\(.value | tostring)"
  ' "$SECRET_PATH" > "$APP_DIRECTORY/.env"
  chmod 0600 "$APP_DIRECTORY/.env"
}

write_postgres_env() {
  local postgres_password
  postgres_password="$(json_value POSTGRES_PASSWORD)"
  if [ -z "$postgres_password" ]; then
    echo "Missing POSTGRES_PASSWORD in AWS Secrets Manager secret $APP_SECRET_NAME" >&2
    exit 1
  fi

  printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password" > "$APP_DIRECTORY/.env.postgres"
  chmod 0600 "$APP_DIRECTORY/.env.postgres"
}

grafana_value() {
  local key default_value value
  key="$1"
  default_value="$2"
  value="$(json_value "$key")"
  if [ -n "$value" ]; then
    printf '%s' "$value"
  else
    printf '%s' "$default_value"
  fi
}

write_grafana_env() {
  local grafana_admin_password
  grafana_admin_password="$(json_value GRAFANA_ADMIN_PASSWORD)"
  if [ -z "$grafana_admin_password" ]; then
    echo "Missing GRAFANA_ADMIN_PASSWORD in AWS Secrets Manager secret $APP_SECRET_NAME" >&2
    exit 1
  fi

  {
    printf 'GRAFANA_ADMIN_USER=%s\n' "$(grafana_value GRAFANA_ADMIN_USER admin)"
    printf 'GRAFANA_ADMIN_PASSWORD=%s\n' "$grafana_admin_password"
    printf 'GRAFANA_POSTGRES_DATASOURCE_NAME=%s\n' "$(grafana_value GRAFANA_POSTGRES_DATASOURCE_NAME Postgres)"
    printf 'GRAFANA_POSTGRES_DATASOURCE_UID=%s\n' "$(grafana_value GRAFANA_POSTGRES_DATASOURCE_UID postgres)"
    printf 'GRAFANA_POSTGRES_HOST=%s\n' "$(grafana_value GRAFANA_POSTGRES_HOST timescaledb-0)"
    printf 'GRAFANA_POSTGRES_PORT=%s\n' "$(grafana_value GRAFANA_POSTGRES_PORT 5432)"
    printf 'GRAFANA_POSTGRES_DATABASE=%s\n' "$(grafana_value GRAFANA_POSTGRES_DATABASE polymarket)"
    printf 'GRAFANA_POSTGRES_USER=%s\n' "$(grafana_value GRAFANA_POSTGRES_USER postgres)"
    printf 'GRAFANA_POSTGRES_SSL_MODE=%s\n' "$(grafana_value GRAFANA_POSTGRES_SSL_MODE disable)"
  } > "$APP_DIRECTORY/.env.grafana"
  chmod 0600 "$APP_DIRECTORY/.env.grafana"
}

start_compose_app() {
  /usr/local/sbin/polymarket-ecr-login

  cd "$APP_DIRECTORY"
  docker compose -f "$COMPOSE_FILE" pull
  docker compose -f "$COMPOSE_FILE" up -d --no-build
  docker compose -f "$COMPOSE_FILE" ps
}

install_base_packages
install_docker
configure_ecr_login_refresh
configure_swap

install -d -m 0700 /root/polymarket
SECRET_PATH="/root/polymarket/secret.json"
aws secretsmanager get-secret-value \
  --region "$AWS_REGION" \
  --secret-id "$APP_SECRET_NAME" \
  --query SecretString \
  --output text > "$SECRET_PATH"
chmod 0600 "$SECRET_PATH"

install_desktop
install_cloudflared
clone_or_update_repo
write_app_env
write_postgres_env
write_grafana_env
start_compose_app
